# ==========================================
# HireNova Environment Variables
# ==========================================

# Backend
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase Free Tier (Get from supabase.com project settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI / LLM (Google AI Studio Free Tier - Gemini 1.5/2.0)
GEMINI_API_KEY=your-gemini-api-key

# Email (Resend Free Tier or SMTP)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=HireNova <interviews@hirenova.ai>

# Code Execution Sandbox (Piston Free API)
PISTON_API_URL=https://emkc.org/api/v2/piston

# Frontend Public Variables
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
